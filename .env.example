# ==============================================================================
# CITIDY — Environment Configuration (.env)
# Product: Smart City Civic Complaint Management Platform
# Tagline: "Your City. Your Voice. Tracked to Resolution."
# ==============================================================================

# Server Configuration
PORT=8000
CITIDY_SECRET_KEY=citidy-production-secret-key-change-in-production-2026

# Supabase Cloud Configuration (Optional: for remote cloud hosting)
# If set, Citidy connects to your Supabase PostgreSQL backend and Auth service.
# If omitted, Citidy runs securely on its included local SQLite & REST backend (server.py).
CITIDY_SUPABASE_URL=https://your-project-id.supabase.co
CITIDY_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Notification Providers (Optional)
# In-app notifications are enabled by default. Email & SMS require provider keys.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@citidy.gov
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM_ADDRESS=notifications@citidy.gov

# Google Maps Embed API (Optional: street map fallback works with zero keys)
CITIDY_GOOGLE_MAPS_EMBED_KEY=
